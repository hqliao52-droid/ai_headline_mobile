{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-ui/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom" 
      }
    },
    {
      "path": "pages/register/register",
      "style": {
        "navigationBarTitleText": "注册"
      }
    },
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页",
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark",
        "onReachBottomDistance": 50
      }
    },
    {
      "path": "pages/ai-chat/ai-chat", 
      "style": {
        "navigationBarTitleText": "",
        "navigationStyle": "custom" 
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "个人中心"
      }
    },
    {
      "path": "pages/news-detail/news-detail",
      "style": {
        "navigationBarTitleText": "新闻详情",
        /*
          转场动画（App 端）：
          App 是原生页面栈，转场交给系统做最顺滑——从右侧滑入，返回时向右退出。
          H5 端的滑入动画写在 news-detail.scss 的 .page-enter 里（条件编译只对非 App 生效），
          两端各用各自最顺手的方式，不会叠加成「滑两次」。
        */
        "app-plus": {
          "animationType": "slide-in-right",
          "animationDuration": 300
        }
      }
    },
    {
      "path": "pages/webView/webView",
      "style": {
        "navigationBarTitleText": "浏览网页",
        "navigationStyle": "default" 
      }
    },
    {
      "path": "pages/personalize/personalize",
      "style": {
        "navigationBarTitleText": "定制化情报",
        "onReachBottomDistance": 50,
        "enablePullDownRefresh": false,
        /* 转场动画（App 端）：与新闻详情页保持一致，从右侧滑入 */
        "app-plus": {
          "animationType": "slide-in-right",
          "animationDuration": 300
        }
      }
    },
    {
      "path": "pages/pushHistory/pushHistory",
      "style": {
         /* 
          配置说明：
          1. onReachBottomDistance: 上拉加载阈值
          2. enablePullDownRefresh: 是否允许下拉刷新
        */
        "navigationBarTitleText": "推送历史",
        "onReachBottomDistance": 50,
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/accountSetting/accountSetting",
      "style": {
        "navigationBarTitleText": "账号设置",
        "onReachBottomDistance": 50,
        "enablePullDownRefresh": false
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "UniApp",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F6F8FC"
  },
  "tabBar": {
    "color": "#9AA8BD",
    "selectedColor": "#2981F0",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/index/index",
        "iconPath": "static/home.png",
        "selectedIconPath": "static/home-active.png",
        "text": "首页"
      },
      {
        "pagePath": "pages/ai-chat/ai-chat",
        "iconPath": "static/ai.png",
        "selectedIconPath": "static/ai-active.png",
        "text": "AI问答"
      },
      {
        "pagePath": "pages/mine/mine",
        "iconPath": "static/mine.png",
        "selectedIconPath": "static/mine-active.png",
        "text": "个人中心"
      }
    ]
  }
}